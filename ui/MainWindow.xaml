<Window x:Class="Elka.VM.EQ.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Elka.VM.EQ.Controls" Title="Elka VM EQ" Width="1140" Height="900" MinWidth="570" MinHeight="450" WindowStyle="None" ResizeMode="CanResize" Background="#09151D" AllowsTransparency="False" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform">
    <Border x:Name="Root" Width="1140" Height="900" BorderBrush="#4A6571" BorderThickness="1" CornerRadius="10" Background="{StaticResource Panel}" Padding="14,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="49"/><RowDefinition Height="286"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragTitle">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Cyan}">VM <Run Foreground="#E1EDF3">EQ</Run></TextBlock><TextBlock Text="NATIVE ENGINE" FontSize="10" Foreground="#8CAEBE" VerticalAlignment="Center" Margin="12,5,0,0"/></StackPanel>
          <Border x:Name="LiveLevelWell" Width="225" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="245,0,0,0" CornerRadius="5" BorderBrush="#41636D" BorderThickness="1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#06131A" Offset="0"/><GradientStop Color="#10242B" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="LIVE LEVEL" FontSize="10" Foreground="#8CAEBE" VerticalAlignment="Center"/>
              <TextBlock x:Name="LiveLevelValue" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="23" Foreground="#81E43B" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="dBFS" FontSize="11" Foreground="#8CAEBE" VerticalAlignment="Center" Margin="7,3,0,0"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ComboBox x:Name="KindBox" Width="114" SelectionChanged="TargetChanged"><ComboBoxItem Content="Strip"/><ComboBoxItem Content="Bus"/></ComboBox>
            <ComboBox x:Name="TargetBox" Width="114" SelectionChanged="TargetChanged"/>
            <TextBlock x:Name="EditionText" Width="101" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13"/>
            <Button x:Name="EqPower" Content="EQ ON" Width="95" Click="PowerClick" ToolTip="Enable or bypass the native EQ. Values are preserved."/>
            <Button Content="—" Width="35" Click="MinimizeClick" ToolTip="Minimize"/><Button Content="×" Width="35" Click="CloseClick" FontSize="21" ToolTip="Close"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#304A59" BorderThickness="0,1,0,1" Padding="0,4">
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="CopyChannel" Content="Ch.Copy" Click="CopyChannelClick"/><Button x:Name="CopyAll" Content="Copy All" Click="CopyAllClick"/><Button x:Name="Paste" Content="Paste" Click="PasteClick"/></StackPanel>
            <StackPanel Orientation="Horizontal"><Button x:Name="FlatAll" Content="FLAT" Width="70" Click="FlatAllClick"/><Button x:Name="BankA" Content="A" Width="39" Click="BankAClick"/><Button x:Name="BankB" Content="B" Width="39" Click="BankBClick"/><TextBlock Text="CHANNEL" FontSize="11" Margin="17,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel x:Name="ChannelsPanel" Orientation="Horizontal"/></StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,9,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="139"/></Grid.ColumnDefinitions>
          <Border BorderBrush="#2C4858" BorderThickness="0,0,1,0" Margin="0,5,9,6"><StackPanel><TextBlock Text="FILTER TYPE" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><StackPanel x:Name="FiltersPanel"/></StackPanel></Border>
          <local:Knob x:Name="FrequencyKnob" Grid.Column="1"/>
          <local:Knob x:Name="GainKnob" Grid.Column="2"/>
          <local:Knob x:Name="QKnob" Grid.Column="3"/>
          <Border Grid.Column="4" BorderBrush="#2C4858" BorderThickness="1,0,0,0" Margin="9,5,0,6" Padding="9,10,0,0"><StackPanel><Button x:Name="BandOn" Content="BAND ON" Height="38" Click="BandOnClick"/><Button x:Name="Solo" Content="Solo curve" Height="38" Click="SoloClick" ToolTip="Only isolates the drawing; does not solo audio."/><Button x:Name="FlatBand" Content="Flat band" Height="38" Click="FlatBandClick"/><Button x:Name="ResetBand" Content="Reset band" Height="38" Click="ResetBandClick"/><TextBlock Text="Drag · Scroll&#10;Shift for fine control" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#304A59" BorderThickness="0,1,0,1" Padding="0,7"><UniformGrid x:Name="BandsPanel" Rows="1"/></Border>
        <Grid Grid.Row="4" Margin="0,5,0,0">
          <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="GraphCaption" Text="FREQUENCY RESPONSE" FontSize="11" Margin="42,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,175,0">
            <Button x:Name="SpectrumPower" Content="RTA OFF" Width="87" Padding="3" Click="SpectrumClick" ToolTip="Optional MAIN audio callback. Close other callback applications before enabling."/>
            <ComboBox x:Name="SpectrumSource" Width="245" SelectionChanged="SpectrumSourceChanged" ToolTip="Bus monitor is the full post-master mix. Strip tap is after input insert, not guaranteed post-EQ."/>
          </StackPanel>
          <ComboBox x:Name="RangeBox" Width="152" HorizontalAlignment="Right" Margin="0,0,17,0" SelectionChanged="RangeChanged" ToolTip="Vertical dB display range. Does not change the EQ settings."/>
          <local:ResponseGraph x:Name="Graph" Grid.Row="1" Width="1110" Height="350"/>
        </Grid>
        <Grid Grid.Row="5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse x:Name="ConnectionLed" Width="6" Height="6" Fill="#56707F" HorizontalAlignment="Left" Margin="9,0,0,0"/>
          <TextBlock x:Name="StatusText" Margin="24,0,12,0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="RenderText" Grid.Column="1" Margin="0,0,12,0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <Button x:Name="DonateButton" Grid.Column="2" Width="104" Height="26" Margin="0" Padding="10,2" VerticalAlignment="Center" Click="DonateClick" ToolTip="Support ElkaSoft on Ko-fi — opens ko-fi.com/msffixit in your browser" AutomationProperties.Name="Donate to ElkaSoft on Ko-fi">
            <Button.Template><ControlTemplate TargetType="Button">
              <Border x:Name="DonateFace" Background="#F08A3E" BorderBrush="#FFA960" BorderThickness="1" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DonateFace" Property="Background" Value="#FFA154"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="DonateFace" Property="Background" Value="#D9762D"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DonateFace" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="DonateFace" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DonateFace" Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Button.Template>
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"><Path Data="M 12,21 C 10,19 2,13 2,7 C 2,1 10,0 12,5 C 14,0 22,1 22,7 C 22,13 14,19 12,21 Z" Fill="#111417"/></Viewbox>
              <TextBlock Text="Donate" Foreground="#111417" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Viewbox>
</Window>
