<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#DAEAF1"/><SolidColorBrush x:Key="Muted" Color="#8CAEBE"/>
  <SolidColorBrush x:Key="Cyan" Color="#29DDED"/>
  <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203743" Offset="0"/><GradientStop Color="#0D1D27" Offset=".6"/><GradientStop Color="#09151D" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#344D5B" Offset="0"/><GradientStop Color="#203440" Offset=".16"/><GradientStop Color="#142733" Offset=".78"/><GradientStop Color="#10212B" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="ActiveFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#285D6D" Offset="0"/><GradientStop Color="#154451" Offset=".2"/><GradientStop Color="#102D3A" Offset="1"/></LinearGradientBrush>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource ButtonFace}"/>
    <Setter Property="BorderBrush" Value="#4C6573"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="4,3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border Background="#030A0F" CornerRadius="7" Margin="0,2,0,-2"/>
        <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <Grid>
            <Border BorderBrush="#244F6879" BorderThickness="1,1,1,0" CornerRadius="5" Margin="1"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <Border x:Name="Led" Background="{StaticResource Cyan}" CornerRadius="1" Height="2" Margin="12,0,12,3" VerticalAlignment="Bottom" Opacity="0"/>
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="Active"><Setter TargetName="Face" Property="Background" Value="{StaticResource ActiveFace}"/><Setter TargetName="Face" Property="BorderBrush" Value="#29DDED"/><Setter TargetName="Led" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#72F2FC"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#75C3DB"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#7FF4FF"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter><Setter TargetName="Face" Property="Opacity" Value=".8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="#132631" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#245467"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#5EEAF6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="4,3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="F" Background="{StaticResource ButtonFace}" BorderBrush="#4C6573" BorderThickness="1" CornerRadius="6"><Grid><Border BorderBrush="#385968" BorderThickness="0,1,0,0" Margin="4,1,4,0"/><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Foreground="#80C9D9"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="BorderBrush" Value="#29DDED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="False" Focusable="False"><Border BorderBrush="#487384" BorderThickness="1" Background="#132631" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#102530"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#466C7D"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#081822"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Cyan}"/><Setter Property="BorderBrush" Value="#39758A"/><Setter Property="Padding" Value="8"/></Style>
</ResourceDictionary>
